    <!--
      SHORT forms, used ONLY by the row summary (not the dialog, which shows the
      full names above). Tap-and-hold joins up to four actions into one line, so
      "ANC, Adapt, Trans, Off" fits where the full names wrap — and a wrapped
      summary makes that row taller than every other row.
    -->
    <string name="gesture_action_anc_adaptive_short">Adapt</string>
    <string name="gesture_action_anc_transparency_short">Trans</string>
    <string name="gesture_action_anc_off_short">Off</string>

